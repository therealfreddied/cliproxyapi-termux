#!/data/data/com.termux/files/usr/bin/env bash
# cliproxy - Termux launcher with self-update & management menu for CLIProxyAPI.
#
# Checks this repo's releases for a newer build on launch, offers to update,
# then provides an interactive management menu or passes through arguments.
set -uo pipefail

REPO="${CLIPROXY_REPO:-therealfreddied/cliproxyapi-termux}"
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
DATA_DIR="${CLIPROXY_DATA:-$HOME/.local/share/cliproxyapi}"
CONFIG_DIR="${CLIPROXY_CONFIG:-$HOME/.config/cliproxyapi}"
CONFIG="${CLIPROXY_CONFIG_FILE:-$CONFIG_DIR/config.yaml}"

BIN="$DATA_DIR/cli-proxy-api"
PREV="$DATA_DIR/cli-proxy-api.prev"
VERFILE="$DATA_DIR/VERSION"
LASTCHECK="$DATA_DIR/.lastcheck"
PIDFILE="$CONFIG_DIR/server.pid"
LOGFILE="$CONFIG_DIR/server.log"

CHECK_INTERVAL="${CLIPROXY_CHECK_INTERVAL:-21600}"   # 6h
TMPBASE="${TMPDIR:-$PREFIX/tmp}"

C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_B=$'\033[1m'
C_G=$'\033[32m'; C_Y=$'\033[33m'; C_R=$'\033[31m'; C_C=$'\033[36m'
if [ ! -t 1 ] || [ "${NO_COLOR:-}" != "" ]; then
  C_RESET=""; C_DIM=""; C_B=""; C_G=""; C_Y=""; C_R=""; C_C=""
fi

say()  { printf '%s[cliproxy]%s %s\n' "$C_C" "$C_RESET" "$*"; }
warn() { printf '%s[cliproxy]%s %s\n' "$C_Y" "$C_RESET" "$*" >&2; }
die()  { printf '%s[cliproxy]%s %s\n' "$C_R" "$C_RESET" "$*" >&2; exit 1; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }

usage() {
  cat <<EOF
${C_B}cliproxy${C_RESET} - CLIProxyAPI management launcher (Termux)

Usage:
  cliproxy                          launch interactive management menu (TUI)
  cliproxy --dashboard              launch server with terminal dashboard (TUI) enabled
  cliproxy [--] [server args...]    launch server directly with custom arguments
  cliproxy --check                  report update status and exit
  cliproxy --update                 update if newer, then exit
  cliproxy --force                  reinstall even if current
  cliproxy --rollback               restore the previous binary
  cliproxy --version                print installed version
  cliproxy --uninstall              remove binary and data (keeps config)
  cliproxy --help                   show this help and upstream CLI arguments

Environment:
  CLIPROXY_REPO            GitHub repo (default: $REPO)
  CLIPROXY_CHECK_INTERVAL  seconds between checks (default: $CHECK_INTERVAL)
  CLIPROXY_NO_UPDATE=1     disable update checking entirely
  CLIPROXY_TOKEN           optional GitHub token (raises API rate limit)

EOF
  say "--- Upstream CLIProxyAPI Arguments ---"
  if [ -x "$BIN" ]; then
    "$BIN" --help 2>&1 || true
  else
    echo "  (cli-proxy-api binary not installed at $BIN)"
  fi
}

installed_version() {
  [ -f "$VERFILE" ] && head -n1 "$VERFILE" 2>/dev/null || echo "unknown"
}

normalize_version() {
  printf '%s' "${1:-}" | sed 's/-termux$//'
}

api_get() {
  local url="$1"
  local -a hdr=(-H "Accept: application/vnd.github+json" -H "User-Agent: cliproxy-termux")
  [ -n "${CLIPROXY_TOKEN:-}" ] && hdr+=(-H "Authorization: Bearer $CLIPROXY_TOKEN")
  curl -fsSL --max-time 25 "${hdr[@]}" "$url" 2>/dev/null
}

latest_release() {
  api_get "https://api.github.com/repos/$REPO/releases/latest" | tag_from_json
}

tag_from_json() {
  local json; json="$(cat)"
  if [ -n "${json:-}" ] && command -v python3 >/dev/null 2>&1; then
    printf '%s' "$json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("tag_name") or "")' 2>/dev/null && return 0
  fi
  printf '%s' "$json" | tr ',' '\n' | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1
}

is_running() {
  if [ -f "$PIDFILE" ]; then
    local pid; pid="$(cat "$PIDFILE" 2>/dev/null || echo "")"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  if pgrep -u "$(id -u)" -f "cli-proxy-api" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

start_server() {
  if is_running; then
    say "server is already running"
    return 0
  fi

  mkdir -p "$CONFIG_DIR"
  [ -f "$CONFIG" ] || warn "no config at $CONFIG"
  say "starting server in background..."
  nohup "$BIN" -config "$CONFIG" > "$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  sleep 1
  if is_running; then
    say "server started successfully (PID: $(cat "$PIDFILE"))"
  else
    warn "server failed to start. Check logs: tail -n 50 $LOGFILE"
  fi
}

stop_server() {
  if [ -f "$PIDFILE" ]; then
    local pid; pid="$(cat "$PIDFILE" 2>/dev/null || echo "")"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      say "stopping server (PID: $pid)..."
      kill "$pid" 2>/dev/null || true
      sleep 1
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
  fi
  pkill -u "$(id -u)" -f "cli-proxy-api" 2>/dev/null || true
  say "server stopped"
}

interactive_menu() {
  [ -x "$BIN" ] || die "not installed. Run install.sh first."

  local server_started_here=""
  if ! is_running; then
    start_server
    server_started_here=1
  fi

  local pushed_to_bg=""

  while true; do
    clear 2>/dev/null || true
    echo "========================================"
    echo " CLIProxyAPI Management Menu (Termux)"
    echo "========================================"
    if is_running; then
      local pid="unknown"
      [ -f "$PIDFILE" ] && pid="$(cat "$PIDFILE")"
      printf " Status : ${C_G}RUNNING${C_RESET} (PID: %s)\n" "$pid"
    else
      printf " Status : ${C_R}STOPPED${C_RESET}\n"
    fi
    printf " Config : %s\n" "$CONFIG"
    echo "========================================"
    echo " 1) Start / Restart Server"
    echo " 2) Stop Server"
    echo " 3) Open Interactive Dashboard (TUI)"
    echo " 4) View Recent Server Logs"
    echo " 5) Push to Background & Exit Menu"
    echo " 6) Quit (Stop Server & Exit)"
    echo "========================================"
    printf "Select option [1-6]: "
    local choice; read -r choice || choice="6"

    case "$choice" in
      1)
        stop_server
        start_server
        server_started_here=1
        echo ""
        read -n 1 -s -r -p "Press any key to continue..."
        ;;
      2)
        stop_server
        echo ""
        read -n 1 -s -r -p "Press any key to continue..."
        ;;
      3)
        echo ""
        say "Launching Terminal Dashboard TUI (press Ctrl+C to return to menu)..."
        "$BIN" -config "$CONFIG" -tui || true
        echo ""
        read -n 1 -s -r -p "Press any key to continue..."
        ;;
      4)
        echo ""
        echo "--- Recent Server Logs (last 40 lines) ---"
        if [ -f "$LOGFILE" ]; then
          tail -n 40 "$LOGFILE"
        else
          echo "No log file found at $LOGFILE"
        fi
        echo "------------------------------------------"
        echo ""
        read -n 1 -s -r -p "Press any key to continue..."
        ;;
      5)
        pushed_to_bg=1
        say "Server pushed to background. Exiting menu."
        break
        ;;
      6)
        stop_server
        say "Server stopped. Exiting."
        break
        ;;
      *)
        say "Invalid choice"
        sleep 1
        ;;
    esac
  done

  if [ -z "$pushed_to_bg" ] && [ -n "$server_started_here" ]; then
    stop_server
  fi
}

do_update() {
  local want="${1:-}" force="${2:-}" explicit="${3:-}"
  command -v curl >/dev/null || die "curl is required"
  want="${want:-$(latest_release)}"
  [ -n "$want" ] || { warn "could not reach GitHub"; return 1; }
  local cur; cur="$(installed_version)"
  if [ "$cur" = "$want" ] && [ -z "$force" ]; then
    say "already up to date ($cur)"
    return 0
  fi

  local tmp; tmp="$(mktemp -d "$TMPBASE/cliproxy-update.XXXXXX")" || die "mktemp failed"
  trap 'rm -rf "$tmp"' RETURN

  local base="https://github.com/$REPO/releases/download/$want"
  local tarball="$tmp/pkg.tar.gz"
  curl -fsSL --max-time 300 -o "$tarball" "$base/cliproxyapi-termux_${want}_aarch64.tar.gz" \
    || curl -fsSL --max-time 300 -o "$tarball" "$base/cliproxyapi-termux_aarch64.tar.gz" \
    || { warn "download failed"; return 1; }

  mkdir -p "$DATA_DIR"
  [ -f "$BIN" ] && cp -f "$BIN" "$PREV" 2>/dev/null
  tar xzf "$tarball" -C "$tmp" || { warn "extract failed"; return 1; }
  local newbin; newbin="$(find "$tmp" -type f -name 'cli-proxy-api' -print -quit)"
  [ -n "$newbin" ] || { warn "cli-proxy-api not found"; return 1; }
  install -m 0755 "$newbin" "$DATA_DIR/cli-proxy-api"
  printf '%s\n' "$want" > "$VERFILE"
  say "updated to $want"
}

main() {
  local action="run"
  local -a passthru=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --check)      action="check"; shift ;;
      --update)     action="update"; shift ;;
      --force)      action="update-force"; shift ;;
      --rollback)   action="rollback"; shift ;;
      --uninstall)  action="uninstall"; shift ;;
      --version|-V) action="version"; shift ;;
      --dashboard)  passthru+=("-tui"); shift ;;
      --help|-h)    usage; exit 0 ;;
      --)           shift; passthru+=("$@"); break ;;
      *)            passthru+=("$1"); shift ;;
    esac
  done

  case "$action" in
    check)
      local cur latest; cur="$(installed_version)"; latest="$(latest_release)"
      printf '  installed : %s\n' "$cur"
      printf '  latest    : %s\n' "${latest:-<unreachable>}"
      [ "$cur" = "$latest" ] && echo "  status    : up to date" || echo "  status    : update available"
      exit 0
      ;;
    version)  printf '%s\n' "$(installed_version)"; exit 0 ;;
    rollback) 
      [ -f "$PREV" ] || die "no previous binary"
      mv -f "$PREV" "$BIN"
      say "rolled back"
      exit 0
      ;;
    uninstall)
      rm -f "$BIN" "$PREV" "$VERFILE" "$LASTCHECK" "$PREFIX/bin/cliproxy"
      say "uninstalled"
      exit 0
      ;;
    update)   do_update "" "" explicit; exit $? ;;
    update-force) do_update "" force; exit $? ;;
  esac

  [ -x "$BIN" ] || die "not installed. run install.sh first."

  # If arguments or dashboard flag were passed, run directly. Otherwise open interactive menu.
  if [ ${#passthru[@]} -gt 0 ]; then
    [ -f "$CONFIG" ] || warn "no config at $CONFIG"
    exec "$BIN" -config "$CONFIG" "${passthru[@]}"
  else
    if [ -t 0 ]; then
      interactive_menu
    else
      # Non-interactive / background: run server directly
      [ -f "$CONFIG" ] || warn "no config at $CONFIG"
      exec "$BIN" -config "$CONFIG"
    fi
  fi
}

main "$@"
